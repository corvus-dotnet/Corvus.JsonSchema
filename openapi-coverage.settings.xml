<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi\.CodeGeneration\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi\.HttpTransport\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi32\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi31\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi30\.dll$</ModulePath>
        <ModulePath>.*Corvus\.Text\.Json\.OpenApi20\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Roslyn source-generator output under obj\ (the per-version OpenAPI document
             models are build-time generated) — machine-generated types whose coverage
             is not actionable. Matches the main dotnet-coverage.settings.xml rule. -->
        <Source>.*\\obj\\.*\.g\.cs$</Source>
        <!-- Auto-generated resource strings -->
        <Source>.*\\SR\.cs$</Source>
        <Source>.*\.Designer\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
