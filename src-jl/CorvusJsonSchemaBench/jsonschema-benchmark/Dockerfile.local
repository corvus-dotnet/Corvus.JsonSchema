# For local comparisons: the package from this checkout (staged by Build-Image.ps1), otherwise as Dockerfile. The
# package needs Julia 1.10 or later and gives the same results with every Julia release. The image runs it on the
# latest.
FROM julia:1.13

RUN apt-get update && apt-get install -y --no-install-recommends time && rm -rf /var/lib/apt/lists/*

COPY CorvusJsonSchema /src/CorvusJsonSchema
COPY bench /app
WORKDIR /app

# Compiles the package and this program into package images. A container then starts with both compiled, as a
# process does on a machine where the package is installed. The images are compiled for the processor of the machine
# that builds them, so build the image on the machine that runs it.
RUN julia --startup-file=no --project=/app -e 'using Pkg; \
        Pkg.develop(path="/src/CorvusJsonSchema"); \
        Pkg.precompile(strict=true)' \
 && echo local > /app/corvus-version

ENTRYPOINT ["/app/memory-wrapper.sh", "julia", "--startup-file=no", "--project=/app", "/app/main.jl"]
CMD []
