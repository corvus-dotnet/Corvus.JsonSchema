# The package assumes the 63-bit int of a 64-bit OCaml.
available: arch != "arm32" & arch != "x86_32" & arch != "ppc32"
# dune's own build field, without "dune subst" for a pinned package. The version is written in dune-project, and
# subst would replace it with the name of the tag (v<version>), which is not the version of the package.
build: [
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
