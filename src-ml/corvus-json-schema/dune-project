(lang dune 3.0)

(name corvus-json-schema)

(version 0.1.1)

(generate_opam_files true)

(source
 (github corvus-dotnet/corvus-json-schema-ocaml))

(homepage https://github.com/corvus-dotnet/Corvus.JsonSchema)

(bug_reports https://github.com/corvus-dotnet/Corvus.JsonSchema/issues)

(authors "Endjin Limited")

(maintainers "Endjin Limited <hello@endjin.com>")

(license Apache-2.0)

(package
 (name corvus-json-schema)
 (synopsis "A fast JSON Schema evaluator (draft 4 to 2020-12) with no dependencies outside the OCaml distribution")
 (description
  "Compiles a JSON Schema once into fail-fast plans and validates JSON text or parsed documents against it. Passes the JSON-Schema-Test-Suite for draft 4, 6, 7, 2019-09 and 2020-12, with results and annotations at the Basic, Detailed and Verbose levels. A port of the Corvus.Text.Json runtime evaluator.")
 (depends
  (ocaml
   (>= 4.14))
  base-unix))
