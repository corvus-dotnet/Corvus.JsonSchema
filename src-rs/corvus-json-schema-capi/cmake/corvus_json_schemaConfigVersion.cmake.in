# Version compatibility for find_package(corvus_json_schema <version>): before 1.0 a minor version may break the ABI,
# so 0.x.y satisfies a request for 0.x.z with z <= y; from 1.0, the same major version satisfies any request below it.
set(PACKAGE_VERSION "@VERSION@")
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _corvus_json_schema_mm "${PACKAGE_VERSION}")
  set(_corvus_json_schema_major "${CMAKE_MATCH_1}")
  set(_corvus_json_schema_minor "${CMAKE_MATCH_2}")
  if(NOT PACKAGE_FIND_VERSION_MAJOR EQUAL _corvus_json_schema_major)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  elseif(_corvus_json_schema_major EQUAL 0 AND NOT PACKAGE_FIND_VERSION_MINOR EQUAL _corvus_json_schema_minor)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
      set(PACKAGE_VERSION_EXACT TRUE)
    endif()
  endif()
endif()
