<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Corvus.Json.Cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <PackAsTool>true</PackAsTool>
    <!-- dotnet publish -r <rid> -p:CliAot=true publishes the tool as native AOT (a global PublishAot would also reach the
         netstandard code-generation projects it references, which cannot be AOT targets). -->
    <PublishAot Condition="'$(CliAot)' == 'true'">true</PublishAot>
    <!-- Spectre.Console.Cli binds command settings by reflection and reads Assembly.Location (IL3000, IL2104): an
         experiment switch keeps those as warnings and roots the assemblies the binder reflects over. -->
    <IlcTreatWarningsAsErrors Condition="'$(CliAotRooted)' == 'true'">false</IlcTreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CliAotRooted)' == 'true'">false</TreatWarningsAsErrors>
    <ToolCommandName>corvusjson</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <NoWarn>$(NoWarn);NU1504;CS1591</NoWarn>
    <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>
    <EndjinDisableAutoPackagesLock>true</EndjinDisableAutoPackagesLock>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>CLI tool for generating strongly-typed C# from JSON Schema, JSONata, JMESPath, and JSON Logic. Supports both Corvus.Text.Json (V5) and Corvus.Json (V4) output. Covers JSON Schema draft 4, 6, 7, 2019-09, and 2020-12.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(CliAotRooted)' == 'true'">
    <TrimmerRootAssembly Include="Spectre.Console.Cli" />
    <TrimmerRootAssembly Include="Corvus.Json.Cli.Core" />
    <TrimmerRootAssembly Include="Corvus.Json.Cli" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Corvus.Json.Cli.Core\Corvus.Json.Cli.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Endjin.RecommendedPractices.GitHub" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
  </ItemGroup>
</Project>