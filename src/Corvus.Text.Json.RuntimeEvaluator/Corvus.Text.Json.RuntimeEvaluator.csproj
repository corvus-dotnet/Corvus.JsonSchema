<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1504</NoWarn>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <IsPackable>true</IsPackable>
    <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>
    <RootNamespace>Corvus.Text.Json.RuntimeEvaluator</RootNamespace>
    <MetaschemaPath>metaschema\</MetaschemaPath>
    <CoreLibSharedDir>..\..\System.Private.CoreLib\src\</CoreLibSharedDir>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Compile JSON Schema (Draft 4 to 2020-12) into an in-memory evaluator at runtime, with zero-allocation flag validation, full results and annotation collection, and no code generation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Corvus.Text.Json\Corvus.Text.Json.csproj" />
  </ItemGroup>
  <!-- Polyfills for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="$(CoreLibSharedDir)System\Runtime\CompilerServices\IsExternalInit.cs" />
    <Compile Include="$(CoreLibSharedDir)System\Diagnostics\CodeAnalysis\NullableAttributes.cs" Link="System\Diagnostics\CodeAnalysis\NullableAttributes.cs" />
    <Compile Include="$(CoreLibSharedDir)System\Index.cs" Link="System\Index.cs" />
    <Compile Include="$(CoreLibSharedDir)System\Range.cs" Link="System\Range.cs" />
    <Compile Include="$(CoreLibSharedDir)System\Numerics\Hashing\HashHelpers.cs" Link="System\Numerics\Hashing\HashHelpers.cs" />
  </ItemGroup>
  <!-- IsExternalInit: also needed for netstandard2.1 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(CoreLibSharedDir)System\Runtime\CompilerServices\IsExternalInit.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared source: the ECMA-262 to .NET regex translator from the code generator. -->
    <Compile Include="..\Corvus.Text.Json.CodeGeneration\EcmaRegexTranslator.cs" Link="Shared\EcmaRegexTranslator.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MetaschemaPath)draft4\schema.json" LogicalName="metaschema.draft4.schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft6\schema.json" LogicalName="metaschema.draft6.schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft7\schema.json" LogicalName="metaschema.draft7.schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\schema.json" LogicalName="metaschema.draft2019-09.schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\applicator.json" LogicalName="metaschema.draft2019-09.meta.applicator.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\content.json" LogicalName="metaschema.draft2019-09.meta.content.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\core.json" LogicalName="metaschema.draft2019-09.meta.core.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\format.json" LogicalName="metaschema.draft2019-09.meta.format.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\hyper-schema.json" LogicalName="metaschema.draft2019-09.meta.hyper-schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\meta-data.json" LogicalName="metaschema.draft2019-09.meta.meta-data.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2019-09\meta\validation.json" LogicalName="metaschema.draft2019-09.meta.validation.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\schema.json" LogicalName="metaschema.draft2020-12.schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\applicator.json" LogicalName="metaschema.draft2020-12.meta.applicator.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\content.json" LogicalName="metaschema.draft2020-12.meta.content.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\core.json" LogicalName="metaschema.draft2020-12.meta.core.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\format-annotation.json" LogicalName="metaschema.draft2020-12.meta.format-annotation.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\format-assertion.json" LogicalName="metaschema.draft2020-12.meta.format-assertion.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\hyper-schema.json" LogicalName="metaschema.draft2020-12.meta.hyper-schema.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\meta-data.json" LogicalName="metaschema.draft2020-12.meta.meta-data.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\unevaluated.json" LogicalName="metaschema.draft2020-12.meta.unevaluated.json" />
    <EmbeddedResource Include="$(MetaschemaPath)draft2020-12\meta\validation.json" LogicalName="metaschema.draft2020-12.meta.validation.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Corvus.Text.Json.RuntimeEvaluator.Tests" />
    <InternalsVisibleTo Include="Corvus.Text.Json.RuntimeEvaluator.Benchmarks" />
    <InternalsVisibleTo Include="Corvus.Text.Json.RuntimeEvaluator.Spike" />
  </ItemGroup>
</Project>
