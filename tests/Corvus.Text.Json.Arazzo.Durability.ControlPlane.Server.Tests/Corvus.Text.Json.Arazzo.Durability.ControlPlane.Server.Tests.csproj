<Project Sdk="MSTest.Sdk">
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>
    <EndjinDisableAutoPackagesLock>true</EndjinDisableAutoPackagesLock>
    <!-- The validate endpoint compiles a JSON Schema at runtime; the host (here, the test) must preserve its
         compilation context so the dynamic compiler has the right defines + reference assemblies. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <NoWarn>$(NoWarn);NU1504;IDE0065;IDE0290;IDE0079;IDE0130;CS1591;CS1572;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- The opt-in LocalStack invoke-and-run gate (ADR 0060) deploys a real AOT bootstrap and runs it. -->
    <PackageReference Include="AWSSDK.Lambda" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.LocalStack" />
    <!-- The opt-in Azure Functions run-from-package deploy gate (ADR 0061) uploads the app package to Azurite blob. -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Testcontainers.Azurite" />
    <!-- The opt-in live-Azure deploy gate (ADR 0061) drives the real ARM configurator against a real Function App. The
         credential types (AzureCliCredential) come from Azure.Core, which Azure.ResourceManager pulls; a separate
         Azure.Identity reference would duplicate them and make the type ambiguous. -->
    <PackageReference Include="Azure.ResourceManager.AppService" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.ControlPlane.Server\Corvus.Text.Json.Arazzo.Durability.ControlPlane.Server.csproj" />
    <!-- The AWS Lambda deployer under test by the live LocalStack invoke-and-run gate. -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.Serverless.Lambda.Deploy\Corvus.Text.Json.Arazzo.Durability.Serverless.Lambda.Deploy.csproj" />
    <!-- The Azure Functions deployer under test by the live run-from-package (Azurite) deploy-and-run gate. -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.Serverless.AzureFunctions.Deploy\Corvus.Text.Json.Arazzo.Durability.Serverless.AzureFunctions.Deploy.csproj" />
    <!-- The real ARM IFunctionAppConfigurator under test by the live-Azure deploy gate. -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.Serverless.AzureFunctions.Deploy.Arm\Corvus.Text.Json.Arazzo.Durability.Serverless.AzureFunctions.Deploy.Arm.csproj" />
    <!-- The function-side HttpWorkflowStateStore drives the end-to-end wire test against the runner's checkpoint surface. -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.Serverless\Corvus.Text.Json.Arazzo.Durability.Serverless.csproj" />
    <!-- The shared Azure Storage run store the deployed checkpoint listener terminates into, which the real-cloud
         run-to-completion gate seeds a run into and reads the completed run back from (ADR 0062). -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.AzureStorage\Corvus.Text.Json.Arazzo.Durability.AzureStorage.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Testing\Corvus.Text.Json.Arazzo.Testing.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json.AsyncApi.Testing\Corvus.Text.Json.AsyncApi.Testing.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Generation\Corvus.Text.Json.Arazzo.Generation.csproj" />
    <!-- The native-build end-to-end proof drives the build worker (and, opt-in, the real container AOT builder). -->
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability.Aot\Corvus.Text.Json.Arazzo.Durability.Aot.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo.Durability\Corvus.Text.Json.Arazzo.Durability.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json.Arazzo\Corvus.Text.Json.Arazzo.csproj" />
  </ItemGroup>
</Project>
