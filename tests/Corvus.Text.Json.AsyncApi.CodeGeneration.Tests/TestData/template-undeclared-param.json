{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Orders API",
    "version": "1.0.0"
  },
  "channels": {
    "orders": {
      "address": "orders/{orderId}/{region}/status",
      "messages": {
        "OrderPlaced": {
          "name": "OrderPlaced",
          "payload": {
            "$ref": "#/components/schemas/orderPlacedPayload"
          }
        }
      },
      "parameters": {
        "orderId": {
          "description": "The order identifier."
        }
      }
    }
  },
  "operations": {
    "publishOrder": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/orders"
      },
      "messages": [
        {
          "$ref": "#/channels/orders/messages/OrderPlaced"
        }
      ]
    },
    "consumeOrders": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/orders"
      },
      "messages": [
        {
          "$ref": "#/channels/orders/messages/OrderPlaced"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "orderPlacedPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
