<Project Sdk="MSTest.Sdk/4.2.2">
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />
  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <Net10Only>true</Net10Only>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1504;IDE0065;IDE0290;IDE0079;IDE0130;CS1591;CS1572;CS1573;CS1030</NoWarn>
    <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>
    <EndjinDisableAutoPackagesLock>true</EndjinDisableAutoPackagesLock>
    <OpenApiSpecFile>..\Corvus.Text.Json.OpenApi.CodeGeneration.Tests\TestData\covspec-2.0.json</OpenApiSpecFile>
    <GeneratedCodeOutputPath>Generated</GeneratedCodeOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(GeneratedCodeOutputPath)\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Corvus.Text.Json.OpenApi\Corvus.Text.Json.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\Corvus.Text.Json\Corvus.Text.Json.csproj" />
    <!-- Build-only dependency: ensures the CLI tool is compiled before our generation target runs. -->
    <ProjectReference Include="..\..\src\Corvus.Json.CodeGenerator\Corvus.Json.CodeGenerator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Endjin.RecommendedPractices.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
  </ItemGroup>

  <!-- Regenerate the server stubs from the OpenAPI 2.0 (Swagger) coverage spec before every
       compilation. Uses - -no-build because the ProjectReference above guarantees the CLI tool
       is already compiled. -->
  <Target Name="GenerateOpenApiTypes" Condition="'$(TargetFramework)' != 'net481'" BeforeTargets="BeforeCompile;CoreCompile">
    <RemoveDir Directories="$(GeneratedCodeOutputPath)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\src\Corvus.Json.CodeGenerator\Corvus.Json.CodeGenerator.csproj&quot; -f net10.0 -c $(Configuration) --no-build -- openapi-server &quot;$(MSBuildThisFileDirectory)$(OpenApiSpecFile)&quot; --rootNamespace CanonTests20.Server --outputPath &quot;$(GeneratedCodeOutputPath)&quot;" />


  </Target>

  <Target Name="IncludeGeneratedOpenApiTypes" Condition="'$(TargetFramework)' != 'net481'" AfterTargets="GenerateOpenApiTypes" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(GeneratedCodeOutputPath)\**\*.cs" />
    </ItemGroup>
  </Target>
</Project>