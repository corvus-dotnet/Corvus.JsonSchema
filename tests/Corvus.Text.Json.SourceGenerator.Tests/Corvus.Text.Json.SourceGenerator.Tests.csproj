<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- On net481 this project cannot run tests (the generator driver and the compiler APIs it exercises
         are net10.0 only). IsTestProject=false stops dotnet test from invoking it, and the sources are
         removed below so the net481 build is an empty assembly, as for Corvus.Text.Json.CodeGenerator.Tests. -->
    <IsTestProject Condition="'$(TargetFramework)' == 'net481'">false</IsTestProject>
  </PropertyGroup>
  <!-- The JSON Schema source generator is referenced as an ordinary assembly so that the tests can
       drive it through a long-lived CSharpGeneratorDriver, the way the compiler server and the IDE do.
       It gets its own test project because its assembly carries private copies of the
       Corvus.Text.Json and Corvus.Json.CodeGeneration types, which would collide with the real
       assemblies in the other test projects. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net481'">
    <ProjectReference Include="..\..\src\Corvus.Text.Json.SourceGenerator\Corvus.Text.Json.SourceGenerator.csproj" ReferenceOutputAssembly="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
  </ItemGroup>
  <!-- The analyzer config the package ships for generated code, so that the test reads the exact text consumers get. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net481'">
    <None Include="..\..\src\Corvus.Text.Json.SourceGenerator\Corvus.Text.Json.SourceGenerator.GeneratedCode.editorconfig" Link="Corvus.Text.Json.SourceGenerator.GeneratedCode.editorconfig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The generator project hands its private System.Text.Json 8 and System.Text.Encodings.Web 8 (netstandard2.0)
       assemblies to every project that references it (GetDependencyTargetPaths), so that analyzer hosts can load them
       next to the generator. This project runs on net10.0, where the framework's version 10 assemblies are the ones
       that load, so the generator's copies are dropped before reference resolution. Keeping them made
       ResolveAssemblyReference see two primary references of different versions to each (MSB3243). -->
  <Target Name="RemoveGeneratorPrivateSystemTextJson" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ResolvedProjectReferencePaths Remove="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'System.Text.Json' or '%(Filename)' == 'System.Text.Encodings.Web'" />
    </ItemGroup>
  </Target>
  <!-- On net481 produce an empty assembly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Compile Remove="**\*.cs" />
  </ItemGroup>
</Project>
