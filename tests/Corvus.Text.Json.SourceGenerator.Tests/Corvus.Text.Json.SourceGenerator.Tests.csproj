<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- The JSON Schema source generator is referenced as an ordinary assembly so that the tests can
       drive it through a long-lived CSharpGeneratorDriver, the way the compiler server and the IDE do.
       It gets its own test project because its assembly carries private copies of the
       Corvus.Text.Json and Corvus.Json.CodeGeneration types, which would collide with the real
       assemblies in the other test projects. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Corvus.Text.Json.SourceGenerator\Corvus.Text.Json.SourceGenerator.csproj" ReferenceOutputAssembly="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
  </ItemGroup>
  <!-- The analyzer config the package ships for generated code, so that the test reads the exact text consumers get. -->
  <ItemGroup>
    <None Include="..\..\src\Corvus.Text.Json.SourceGenerator\Corvus.Text.Json.SourceGenerator.GeneratedCode.editorconfig" Link="Corvus.Text.Json.SourceGenerator.GeneratedCode.editorconfig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The generator project hands its private System.Text.Json 8 (netstandard2.0) assembly to every project that
       references it (GetDependencyTargetPaths), so that analyzer hosts can load it next to the generator. This
       project runs on net10.0, where the framework's System.Text.Json 10 is the assembly that loads, so the
       generator's copy is dropped before reference resolution. Keeping both made ResolveAssemblyReference see two
       primary System.Text.Json references of different versions (MSB3243). -->
  <Target Name="RemoveGeneratorPrivateSystemTextJson" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ResolvedProjectReferencePaths Remove="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'System.Text.Json'" />
    </ItemGroup>
  </Target>
</Project>
