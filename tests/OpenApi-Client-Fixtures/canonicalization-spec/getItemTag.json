{
  "spec": "canonicalization-spec.json",
  "operationId": "getItemTag",
  "cases": [
    {
      "name": "200 parses the JSON object body",
      "rows": [
        33,
        38
      ],
      "input": {
        "path": {
          "itemId": 1,
          "tagName": "t"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tag": "important",
          "weight": 5
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/items/1/tags/t",
        "headers": {
          "accept": "application/json"
        },
        "noBody": true
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok",
        "body": {
          "tag": "important",
          "weight": 5
        }
      }
    },
    {
      "name": "two path parameters and an optional query parameter",
      "rows": [
        7,
        11
      ],
      "input": {
        "path": {
          "itemId": 99,
          "tagName": "my tag"
        },
        "query": {
          "score": 7.5
        }
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "expectRequest": {
        "method": "GET",
        "path": "/items/99/tags/my%20tag?score=7.5"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
