{
  "spec": "canonicalization-spec.json",
  "operationId": "search",
  "cases": [
    {
      "name": "required query only",
      "rows": [
        11,
        21
      ],
      "input": {
        "query": {
          "q": "widgets"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=widgets",
        "noBody": true
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "all query parameters are appended in document order",
      "rows": [
        11,
        21
      ],
      "input": {
        "query": {
          "q": "test",
          "page": 3,
          "rating": 4.5
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=test&page=3&rating=4.5"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "reserved characters in a string query value are percent-encoded",
      "rows": [
        7,
        11
      ],
      "input": {
        "query": {
          "q": "a&b=c d,e"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=a%26b%3Dc%20d%2Ce"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "non-ASCII query value is percent-encoded as UTF-8",
      "rows": [
        11
      ],
      "input": {
        "query": {
          "q": "caf\u00e9"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=caf%C3%A9"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "optional page omitted while rating is sent",
      "rows": [
        19,
        21
      ],
      "input": {
        "query": {
          "q": "x",
          "rating": 0.5
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=x&rating=0.5"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "optional rating omitted while page is sent",
      "rows": [
        19,
        21
      ],
      "input": {
        "query": {
          "q": "x",
          "page": 2
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=x&page=2"
      },
      "expect": {
        "kind": "ok",
        "status": 200,
        "case": "Ok"
      }
    },
    {
      "name": "502 is not a declared response and matches no case",
      "rows": [
        33,
        35
      ],
      "input": {
        "query": {
          "q": "q"
        }
      },
      "response": {
        "status": 502,
        "body": {}
      },
      "expectRequest": {
        "method": "GET",
        "path": "/search?q=q"
      },
      "expect": {
        "kind": "ok",
        "status": 502
      }
    }
  ]
}