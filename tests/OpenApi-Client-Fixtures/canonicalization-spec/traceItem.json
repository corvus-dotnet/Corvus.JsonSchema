{
  "spec": "canonicalization-spec.json",
  "operationId": "traceItem",
  "cases": [
    {
      "name": "200 sends TRACE and returns the text body",
      "rows": [40, 56],
      "input": { "path": { "itemId": "t-1" } },
      "response": { "status": 200, "headers": { "Content-Type": "text/plain" }, "bodyText": "TRACE /items/t-1 HTTP/1.1" },
      "expectRequest": { "method": "TRACE", "path": "/items/t-1", "noBody": true },
      "expect": { "kind": "ok", "status": 200, "case": "Ok", "bodyText": "TRACE /items/t-1 HTTP/1.1" }
    },
    {
      "name": "Accept header is derived from the declared text media type",
      "rows": [17],
      "input": { "path": { "itemId": "t-1" } },
      "response": { "status": 200, "headers": { "Content-Type": "text/plain" }, "bodyText": "x" },
      "expectRequest": { "method": "TRACE", "path": "/items/t-1", "headers": { "accept": "text/plain" } },
      "expect": { "kind": "ok", "status": 200, "case": "Ok" }
    },
    {
      "name": "an undeclared status matches no response case",
      "rows": [33, 35],
      "input": { "path": { "itemId": "t-1" } },
      "response": { "status": 405 },
      "expect": { "kind": "ok", "status": 405 }
    }
  ]
}
